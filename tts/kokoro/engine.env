# Read by scripts/install-venv.sh. Shell syntax, no spaces around "=".
SERVER=ovos-tts-server
PLUGIN=ovos-tts-plugin-kokoro
PORT=9666
SERVER_ARGS="--cache"
# kokoro and misaki declare requires-python <3.13.
PYTHON_MIN=3.10
PYTHON_MAX=3.12
# On Linux, install CPU-only torch first, or pip pulls the ~2 GB CUDA build.
TORCH_CPU=1
# The macOS wheel of espeakng-loader (0.2.4) looks for its data at a path on
# its build machine. Any word that falls back to espeak then kills the server.
# On macOS, use the Docker recipe.
VENV_PLATFORMS="Linux"
